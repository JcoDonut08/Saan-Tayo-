{
  "expo": {
    "name": "Saan Tayo?",
    "slug": "saan-tayo",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "saantayo",
    "icon": "./assets/images/saan-tayo-logo.png",
    "backgroundColor": "#080B0C",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/saan-tayo-logo.png",
        "backgroundColor": "#080B0C"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "androidStatusBar": {
      "backgroundColor": "#080B0C",
      "barStyle": "light-content",
      "translucent": true
    },
    "web": {
      "favicon": "./assets/images/saan-tayo-logo.png",
      "output": "static"
    },
    "splash": {
      "image": "./assets/images/saan-tayo-logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#080B0C"
    },
    "plugins": ["expo-router"],
    "experiments": {
      "typedRoutes": true
    }
  }
}
