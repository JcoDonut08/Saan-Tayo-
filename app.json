{
  "expo": {
    "name": "Saan Tayo?",
    "slug": "saan-tayo",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "saantayo",
    "backgroundColor": "#080B0C",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "androidStatusBar": {
      "backgroundColor": "#080B0C",
      "barStyle": "light-content",
      "translucent": true
    },
    "web": {
      "output": "static"
    },
    "plugins": ["expo-router"],
    "experiments": {
      "typedRoutes": true
    }
  }
}
